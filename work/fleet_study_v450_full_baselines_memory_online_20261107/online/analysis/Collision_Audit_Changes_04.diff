+def recorded_collision_evidence(rd,folder,require_complete):
+    # Inspect every collision element, independent of collider/victim/type.
+    # SUMO vehicle collision counters alone do not establish intermodal coverage.
+    path=folder/'collisions.xml';elements=None
+    if path.exists():
+        tree=ET.parse(rd.track(path)).getroot()
+        elements=[dict(x.attrib) for x in tree.iter() if x.tag.rsplit('}',1)[-1]=='collision']
+    logs=[];warnings=[]
+    for name in ('sumo.log','stdout.log'):
+        path=folder/name
+        if not path.exists():continue
+        logs.append(name)
+        for number,line in enumerate(rd.track(path).read_text(encoding='utf-8-sig',errors='replace').splitlines(),1):
+            if re.search(r'\b(?:warning|error)\b',line,re.I) and re.search(r'\b(?:collid\w*|collision\w*|intermodal)\b',line,re.I):
+                warnings.append(dict(file=name,line=number,text=line))
+    complete=elements is not None and len(logs)==2
+    if require_complete:
+        assert complete,('Missing collision evidence',folder,logs)
+        assert not elements and not warnings,('Recorded collision or relevant warning',folder,elements,warnings)
+    return dict(collision_evidence_complete=complete,collision_xml_element_count=None if elements is None else len(elements),
+        collision_xml_records=json.dumps(elements,sort_keys=True),collision_warning_line_count=len(warnings),
+        collision_warning_records=json.dumps(warnings,sort_keys=True),collision_logs_checked=';'.join(logs))
+
 
